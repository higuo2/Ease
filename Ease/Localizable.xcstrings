    "bmi.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These bands are population cutoffs, not a diagnosis. Muscle mass and water retention can move BMI away from body fat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区间来自人群切点，不是诊断。肌肉量和水分滞留都会让 BMI 偏离体脂。"
          }
        }
      }
    },
    "bmi.formula.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI = weight (kg) ÷ height (m)². Age and sex are not used in this number."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI = 体重 (kg) ÷ 身高 (m)²。年龄和性别不进入这个数字。"
          }
        }
      }
    },
