    "onboarding.philosophy.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Objective records." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "客观记录。" } }
      }
    },
    "onboarding.philosophy.subtitle" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Trends only. No judgment." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只看趋势，不作评价。" } }
      }
    },
    "onboarding.philosophy.point1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The dashboard follows a 7-day moving average, not a single morning on the scale." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "看板跟随 7 日均线，而不是某一天的秤数。" } }
      }
    },
    "onboarding.philosophy.point2" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No calorie counting. No macros." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不算卡路里，不记三大营养素。" } }
      }
    },
    "onboarding.philosophy.point3" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No social features. Data stays on this device and your iCloud." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无社交。数据只留在本机与你的 iCloud。" } }
