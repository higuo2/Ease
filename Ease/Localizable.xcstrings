    },
    ", ": {
      "comment": "A conjunction used to join two independent clauses, such as \"the cat, and the mouse\".",
      "isCommentAutoGenerated": true
    },
    "%lld": {
      "comment": "A day number displayed in a calendar view. The number is the day of the month for the given date.",
      "isCommentAutoGenerated": true
    },
