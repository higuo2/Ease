      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ease reads activity, sleep, and menstrual data to display beside your weight trend."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ease 读取活动消耗、睡眠与经期数据，用于和体重趋势一起展示。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ease reads a scale photo to prefill weight and body fat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ease 读取体脂秤照片，用于预填体重与体脂。"
          }
        }
      }
    }
  },
  "version" : "1.0"
